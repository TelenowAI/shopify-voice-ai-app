# ──────────────────────────────────────────────────────────────────────────────
# Production environment. Copy to `.env.production` ON THE SERVER and fill in.
#
#   cp .env.production.example .env.production && nano .env.production
#
# .env.production is gitignored and is read by docker-compose (env_file). It
# holds SHOPIFY_API_SECRET — treat the file as a secret: chmod 600, never commit.
# ──────────────────────────────────────────────────────────────────────────────

# ── Public origin ─────────────────────────────────────────────────────────────
# The HTTPS domain this app answers on, no trailing slash. MUST match the domain
# in deploy/Caddyfile and the URLs registered in the Shopify Partners dashboard.
#
# Everything derives from this: the OAuth callback, the Shopify webhook targets,
# and the Telenow webhook target. Changing it after merchants have installed
# breaks their webhooks until they reinstall — pick the final domain now.
#
# The variable is HOST. It is NOT SHOPIFY_APP_URL — that one is set by the
# Shopify CLI during `shopify app dev` and is read only by scripts/dev-cli.js.
# Setting SHOPIFY_APP_URL in production looks correct and silently does nothing;
# the app falls back to http://localhost:3000 and OAuth can never complete.
#
# On Render you may omit HOST entirely: RENDER_EXTERNAL_URL is injected into
# every web service and is used automatically. Set HOST explicitly once you put
# a custom domain in front, because RENDER_EXTERNAL_URL always returns the
# *.onrender.com address.
HOST=https://app.example.com

# Internal container port. Caddy proxies to this; do not publish it.
PORT=3000

# ── Shopify app credentials ───────────────────────────────────────────────────
# Partners dashboard → your app → API access. The secret signs webhook HMACs and
# session tokens, so a leak lets anyone forge either.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Must match [access_scopes].scopes in shopify.app.toml, or the install loop
# re-prompts for consent on every request.
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,read_checkouts,read_fulfillments

# REST Admin version for order tag/note write-backs (src/shopify.js:39).
# Separate from the library version used for OAuth + webhook HMAC, which is
# pinned in code to ApiVersion.January25.
SHOPIFY_API_VERSION=2025-10

# ── Telenow API ───────────────────────────────────────────────────────────────
TELENOW_API_BASE=https://api.telenow.ai
# Note: no Telenow API key here. Each merchant pastes their own vai_live_... key
# into the in-app settings page; it is stored per-shop in the data volume.

# ── Persistence ───────────────────────────────────────────────────────────────
# Path INSIDE the container. Backed by the `telenow-data` Docker volume — see
# docker-compose.yml. Do not point this at a path that isn't a mounted volume.
DATA_DIR=/data

# ── Automation tuning (optional) ──────────────────────────────────────────────
# Interval for the win-back / reviews / post-purchase sweeps. Default 6h.
SWEEP_INTERVAL_MS=21600000
# Set to 1 ONLY for a one-off test: it runs a sweep at boot, which places real
# calls to real customers. Leave unset in production.
# SWEEP_RUN_ON_BOOT=1

# Default country used to normalise phone numbers missing a country code
# (src/util/phone.js). Set to your merchants' primary market, e.g. IN, US, GB.
DEFAULT_PHONE_COUNTRY=IN
