# ──────────────────────────────────────────────────────────────────────────
# Telenow Shopify App — environment
# Copy to `.env` and fill in. NEVER commit the real .env.
# ──────────────────────────────────────────────────────────────────────────

# ── App host ────────────────────────────────────────────────────────────────
# The public HTTPS URL where this app is reachable (no trailing slash).
# In dev, use an ngrok/cloudflared tunnel, e.g. https://abcd-1234.ngrok-free.app
# This is used to build the OAuth callback URL and the Telenow webhook target URL.
HOST=https://your-tunnel.ngrok-free.app
PORT=3000

# ── Shopify app credentials ──────────────────────────────────────────────────
# From your app in the Shopify Partners dashboard (Apps → your app → API access).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Scopes the app requests during OAuth. Must match the app config in Partners.
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,read_checkouts,read_fulfillments

# Shopify Admin REST API version used for write-backs (order tags/notes).
SHOPIFY_API_VERSION=2025-10

# ── Telenow API ──────────────────────────────────────────────────────────────
# Base URL of the Telenow public API. Default works for production.
TELENOW_API_BASE=https://api.telenow.ai

# NOTE: the Telenow API key is NOT set here. Each merchant pastes their own
# `vai_live_...` key in the in-app settings page (/app). It is stored per-shop.

# ── Persistence (stub) ────────────────────────────────────────────────────────
# Directory where the file-based store keeps shop sessions, settings and the
# sessionId→orderId map. Swap the whole store for a real DB in production.
DATA_DIR=./data
