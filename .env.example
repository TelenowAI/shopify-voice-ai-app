# ──────────────────────────────────────────────────────────────────────────
# Telenow Shopify App — environment
# Copy to `.env` and fill in. NEVER commit the real .env.
# ──────────────────────────────────────────────────────────────────────────

# ── App host ────────────────────────────────────────────────────────────────
# The public HTTPS URL where this app is reachable (no trailing slash).
# In dev, use an ngrok/cloudflared tunnel, e.g. https://abcd-1234.ngrok-free.app
# This is used to build the OAuth callback URL and the Telenow webhook target URL.
HOST=https://your-tunnel.ngrok-free.app
PORT=3000

# ── Shopify app credentials ──────────────────────────────────────────────────
# From your app in the Shopify Partners dashboard (Apps → your app → API access).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Scopes the app requests during OAuth. Must match the app config in Partners.
SHOPIFY_SCOPES=read_orders,write_orders,read_customers,read_checkouts,read_fulfillments

# Shopify Admin REST API version used for write-backs (order tags/notes).
SHOPIFY_API_VERSION=2025-10

# ── Telenow API ──────────────────────────────────────────────────────────────
# Base URL of the Telenow public API. Default works for production.
TELENOW_API_BASE=https://api.telenow.ai

# ── Telenow calling workspaces ───────────────────────────────────────────────
# The merchant NEVER supplies a Telenow key. The app leases one per shop from a
# pool that an operator mints ahead of time (see DEPLOY.md § Key pool).
# JSON array; alternatively drop the same array in ${DATA_DIR}/keypool.json.
# Without it every call route answers 503 provisioning — the app cannot dial.
#
# Each entry is { ref, apiKey, numberE164, numberId, provider, country }.
# `provider` is the lowercase platform id ('twilio' | 'plivo' | 'exotel' |
# 'vonage' | 'sip'); `country` is the ISO-3166-1 alpha-2 code of the number
# itself, NOT of the merchant. Both are optional and both are new: an entry
# without them still leases and is simply treated as unknown-origin. They are
# never guessed — an unlabelled entry is used only as the last-resort fallback.
#
# WHY THE COUNTRY MATTERS. At install the app resolves the shop's own country
# from Shopify and asks the pool for a matching number first, falling back to
# any free entry rather than refusing to lease. Stock the countries your
# merchants actually sell from: a foreign DID dialling a local mobile is
# routinely blocked or spam-filtered by the destination carrier, and the merchant
# sees a call that never connects rather than an error they can act on.
#
# SEED AT LEAST TWO NORTH-AMERICAN NUMBERS BEFORE SHOPIFY APP REVIEW. The
# reviewer works from North America and "Send a test call" is the most prominent
# button in the app; an Indian DID ringing their mobile is the single most likely
# way for the resubmission to fail requirement 2.1.1 (functionality), where all
# the billing work buys nothing. Two, not one, so a reviewer who reinstalls does
# not land on the last free entry from another continent.
TELENOW_KEY_POOL=[{"ref":"ws-01","apiKey":"vai_live_...","numberE164":"+14155550123","numberId":"...","provider":"twilio","country":"US"},{"ref":"ws-02","apiKey":"vai_live_...","numberE164":"+16475550123","numberId":"...","provider":"twilio","country":"CA"},{"ref":"ws-03","apiKey":"vai_live_...","numberE164":"+919876543210","numberId":"...","provider":"plivo","country":"IN"}]

# v1.1 only — server-to-server provisioning. Leave unset in v1.
# TELENOW_PARTNER_KEY=

# ── Phone-number country (optional) ──────────────────────────────────────────
# LAST-RESORT fallback only. A customer phone number written in local format
# ("9876543210") has to be given a country before it can be dialled, and the app
# resolves that per shop: explicit argument → the shop's own country from
# Shopify (cached as settings.shopCountry) → this variable → 'US'.
#
# Leave it unset unless you know every merchant on this instance sells from one
# market. It is process-wide, so on a multi-tenant server it is the wrong answer
# for everybody except that one market — which is why it now sits behind the
# per-shop lookup rather than in front of it.
# DEFAULT_PHONE_COUNTRY=US

# ── Persistence (stub) ────────────────────────────────────────────────────────
# Directory where the file-based store keeps shop sessions, settings and the
# sessionId→orderId map. Swap the whole store for a real DB in production.
DATA_DIR=./data
