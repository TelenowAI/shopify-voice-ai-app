# Replace app.example.com with the domain you pointed at this instance's
# Elastic IP, and the email with yours (Let's Encrypt uses it for expiry
# warnings). Caddy obtains and renews the certificate automatically — there is
# nothing else to configure for HTTPS.

{
	email you@example.com
}

app.example.com {
	encode gzip

	# Caddy sets X-Forwarded-Proto/For; the app reads them via `trust proxy`.
	reverse_proxy app:3000

	log {
		output stdout
		format console
	}
}
